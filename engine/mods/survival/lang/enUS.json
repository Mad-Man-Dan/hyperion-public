    "mode/survival/line": "Waves until the count runs out, then the push.",
    "mode/survival/about": "One home inside a perimeter read from the map. A build-up with no waves, then a wave every gap, cleared or not, out of the enemy base. Every fifth wave is an assault, half again as big, through two gates, led by an elite. Clearing the last wave lifts the perimeter; with the push on, the enemy base is then an ordinary computer player and its last building ends the game.",
    "mode/survival/note/1": "The waves are the race the enemy base plays, chosen in its slot like any computer. Random is drawn from the run's seed.",
    "mode/survival/note/2": "Units outside the perimeter lose a share of their own life every second. The four tiles just outside it are a warning only.",
    "mode/survival/note/3": "The perimeter grows four tiles every fifth wave cleared.",
    "mode/survival/setting/unique_groups/name": "Unique groups",
    "mode/survival/setting/unique_groups/group": "The run",
    "mode/survival/setting/unique_groups/gist": "How often a group that walks in is a unique group: every unit in it sharing one rolled set of effects, with a name and a look of its own. Stronger than the line it comes with, weaker than an elite.",
    "mode/survival/setting/difficulty/name": "Difficulty",
    "mode/survival/setting/difficulty/group": "The run",
    "mode/survival/setting/difficulty/gist": "How many waves come, how big they are, how far apart, from which wave elites ride, and how the enemy base plays after the lift.",
    "mode/survival/setting/difficulty/choice/recruit": "Recruit",
    "mode/survival/setting/difficulty/choice/veteran": "Veteran",
    "mode/survival/setting/difficulty/choice/hardened": "Hardened",
    "mode/survival/setting/difficulty/choice/brutal": "Brutal",
    "mode/survival/setting/difficulty/choice/nightmare": "Nightmare",
    "mode/survival/setting/difficulty/choice/insane": "Insane",
    "mode/survival/setting/perimeter/name": "Perimeter",
    "mode/survival/setting/perimeter/group": "The ground you hold",
    "mode/survival/setting/perimeter/gist": "How far the edge sits from your base. It is read from the map, not set in tiles, so one choice fits every map.",
    "mode/survival/setting/perimeter/choice/tight": "Tight",
    "mode/survival/setting/perimeter/choice/standard": "Standard",
    "mode/survival/setting/perimeter/choice/wide": "Wide",
    "mode/survival/setting/allies_perimeter/name": "Allies' perimeter",
    "mode/survival/setting/allies_perimeter/group": "The ground you hold",
    "mode/survival/setting/allies_perimeter/gist": "With two to four players, one perimeter round every home or one round each.",
    "mode/survival/setting/allies_perimeter/choice/shared": "Shared",
    "mode/survival/setting/allies_perimeter/choice/each": "One each",
    "mode/survival/setting/push/name": "Push the enemy base",
    "mode/survival/setting/push/group": "The ending",
    "mode/survival/setting/push/gist": "On, clearing the last wave lifts the perimeter and the enemy base is yours to take. Off, clearing the last wave is the win.",
    "mode/survival/setting/show_next_wave/name": "Show next wave",
    "mode/survival/setting/show_next_wave/group": "The ending",
    "mode/survival/setting/show_next_wave/gist": "The counter names what the next wave carries, its elites and the rolled mid-bosses among them.",
    "mode/survival/setting/elites/name": "Elites",
    "mode/survival/setting/elites/group": "The run",
    "mode/survival/setting/elites/gist": "How strong the elites are and how often they ride, against the run's own schedule. Every elite is rolled, whatever body it wears: its stats, its affixes, its spell and its name are new each run.",
    "mode/survival/setting/start_wave/name": "Start at wave",
    "mode/survival/setting/start_wave/group": "The run",
    "mode/survival/setting/start_wave/gist": "The wave the run begins at, for trying a wave without playing up to it. 1 plays the whole run.",
    "mode/survival/setting/seed/name": "Run",
    "mode/survival/setting/seed/group": "The run",
    "mode/survival/setting/seed/gist": "The number the whole run is rolled from: its waves, its elites, the mid-bosses and their spells. Type one in to play the same run again.",
    "mode/survival/preset/holdout/name": "Holdout",
    "mode/survival/preset/holdout/line": "A perimeter each and no base to take: hold your own start until the waves run out.",
    "mode/survival/preset/gauntlet/name": "The gauntlet",
    "mode/survival/preset/gauntlet/line": "Insane, tight, no preview: forty waves on one base, and nothing named before it arrives.",
