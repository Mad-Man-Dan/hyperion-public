{
  "comment": "Survival's content: three race libraries of spells, statuses and effects the waves draw on, the seven bodies a run rolls its elites onto, and the hooks that roll a run and play the mode. The names are our own; no ability of another game is copied. What the format cannot say falls to a Luau function through {\"do\": \"script\"}. The effects are in looks.json.",

  "generate": "LsGenerate",

  "game": {
    "start": "LsStart",
    "tick": "LsTick",
    "every": 1,
    "on_death": "LsOnDeath",
    "director": {"call": "LsDirector", "every": 1}
  },
  "marks": {
    "comment": "the looks the perimeter and its band may wear, by name: how a mark of that look is drawn, in map pixels and seconds -- a minimap block alone is in the minimap's own pixels. scripts/mode.luau's LOOK picks one and says the rest -- the shape, the colour, who sees it and what lights it. The numbers are the design's; every one of them is also the engine's own default, written out so that a change to a default never moves the perimeter without this file saying so.",

    "ward": {
      "about": "A low wall of light standing on the perimeter.",
      "warn": "#ffb347", "edge_width": 3, "pulse": 2.2, "pulse_depth": 0.3,
      "curve": "sharp", "crossing": "ripple",
      "field": {"height": 26, "bands": 6, "alpha": 0.42, "fade": 1, "add": true},
      "cells": {"spacing": 13, "rows": [0.30, 0.72], "stagger": 0.5, "radius": 4.2,
                "squash": 0.8, "width": 1, "alpha": 0.7, "least": 0.12, "base": 0.55,
                "swing": 0.45, "rate": 3.1, "along": 0.37, "row": 1.7, "warm": 0.2},
      "foot": {"glow": 4, "alpha": 0.22},
      "tear": {"life": 0.9, "width": 10, "grow": 30, "height": 1.6, "alpha": 0.9},
      "ripple": {"speed": 384, "width": 46, "life": 1.6, "flash": 50, "flash_life": 0.5},
      "outside": {"style": "tint", "band": 128, "radius": 26, "alpha": 0.55, "base": 0.65,
                  "swing": 0.35, "beat": 4, "past": 9, "color": "#ffb347",
                  "far_color": "#e0453a"},
      "minimap": {"comment": "the ring on the minimap as well as the ground, so a player reads the whole perimeter rather than the stretch in front of them. It takes no colour of its own, so it is drawn in the ring's, and nothing of the field, the beat or the light reaches it: it shows whole, whatever the ground is doing. width and dash are minimap pixels, not the map's. Every renderer draws this, the fallback included, which is where a player would otherwise see no perimeter at all.",
                  "on": true, "fill": 0, "edge": 1, "width": 1, "dash": 2}
    },

    "line": {
      "about": "The perimeter as a plain ring, the look it wore before the ward. It has no blocks, so it stands nothing up off the ground: it is the edge and the glow under it.",
      "edge": 0.9, "edge_width": 6, "soft": 1,
      "outside": {"style": "tint", "band": 128},
      "minimap": {"on": true, "fill": 0, "edge": 1, "width": 1, "dash": 0}
    },

    "band": {
      "about": "The warning band, on the minimap and nowhere else. The ground shows the band as the light under a unit standing in it, which is a light rather than a shape, so there is nothing of it for the minimap to draw; a mark in this look is that shape. It draws nothing on the ground -- no blocks, and an edge of nothing -- and on the minimap it is dashed and in the warning colour, so a player reads where the cost begins as well as where the line is. The dash is what tells the two rings apart: four tiles of band is four minimap pixels on a 128-tile map, so the gap between them is not what the player sees.",
      "fill": 0, "edge": 0,
      "minimap": {"on": true, "fill": 0, "edge": 1, "width": 1, "dash": 3, "color": "#ffb347"}
    }
  },

  "statuses": {
    "t_scorched": {"name": "Scorched", "duration": 4, "damage_per_second": 10, "stacking": "refresh",
      "overlay": "thingy_ofirev", "overlay_by_size": true},
    "t_slagged": {"comment": "a status's kind picks the glyph, the hue and the icon a player reads it by, and it is worked out from the fields in a fixed order: what stops the unit, then what hurts it, then the rest. That names the first field it finds, which for a status with two is not always what the status is about -- Slagged is a slow with a burn beside it, not a burn -- so look.kind is written out on the ten where the order would name the lesser half. The other thirty-two read right from their fields and say nothing.",
      "name": "Slagged", "look": {"kind": "slow"}, "duration": 6, "move_speed": -35, "damage_per_second": 4,
      "overlay": "thingy_ensgoos", "overlay_by_size": true},
    "t_jammed": {"name": "Jammed", "duration": 5, "attack_cooldown": 60, "start_image": "thingy_emp"},
    "t_blinded": {"name": "Blinded", "duration": 3, "cannot_attack": true, "start_image": "thingy_empl"},
    "t_clamped": {"name": "Clamped", "duration": 3, "cannot_move": true, "overlay": "thingy_empl"},
    "t_marked": {"name": "Marked", "duration": 8, "armor": -3, "stacking": "stack", "max_stacks": 3,
      "overlay": "terran_tcirglow"},
    "t_braced": {"name": "Braced", "duration": 8, "armor": 3, "overlay": "thingy_pshield"},
    "t_veiled": {"name": "Veiled", "duration": 6, "armor": 2, "move_speed": 15, "overlay": "thingy_smoke"},
    "t_mending": {"name": "Mending", "duration": 6, "life_per_second": 8, "overlay": "thingy_tmehealm"},
    "t_overclocked": {"comment": "side is written out on the three a caster puts on itself, whose fields point both ways: a cost beside the gain (the burn here, no attacking while it molts, no moving while it is anchored) that the sum would weigh against the gain. Every other status reads right from its fields alone.",
      "name": "Overclocked", "side": "good", "duration": 10, "attack_cooldown": -35, "damage_dealt": 20,
      "damage_per_second": 2, "overlay": "thingy_tveglowo"},
    "t_anchored": {"name": "Anchored", "look": {"kind": "might"}, "side": "good", "duration": 8, "cannot_move": true, "damage_dealt": 50, "armor": 2,
      "overlay": "thingy_tbaglow"},
    "t_drone_warded": {"name": "Drone-warded", "duration": 12, "armor": 2, "life_per_second": 3,
      "overlay": "thingy_tdrglow"},

    "z_corroded": {"comment": "an overlay is never a bullet's image. The acid spores, the plague cloud, the seeker spores, the parasite and the consume effect are all a weapon's own picture, and a bullet's script does a bullet's damage when its death animation runs: put one on a unit and the unit's death runs it with no bullet behind it, which is a crash and an attack sound out of nowhere. The pictures below are overlays, the ones classic hangs on a unit, so look for a thingy_ name or a glow and never a name a weapon also has. overlay_by_size wants three images in a row, small then medium then large, which the ensnare goo and the parasite have and the devourer's goo does not: its next two rows are the small one's deeper stacks.",
      "name": "Corroded", "duration": 8, "armor": -4, "stacking": "stack", "max_stacks": 4,
      "overlay": "thingy_zdvgoos"},
    "z_bile_rot": {"name": "Bile rot", "duration": 8, "damage_per_second": 7, "stacking": "stack",
