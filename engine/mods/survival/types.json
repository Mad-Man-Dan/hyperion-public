  "orders": {
    "ls_t_scorch_round": {"base": "cast_psionic_storm", "weapon": "ls_t_scorch_round",
      "tech": "ls_t_scorch_round",
      "comment": "Each spell is Psionic Storm's order with its own weapon and tech, and blocks in place of firing. The script blocks are in scripts/spells.luau.",
      "blocks": [
        {"do": "show", "sprite": "thingy_eldfire"},
        {"do": "damage", "amount": 24, "damage_type": "explosive", "radius": 72, "targets": "enemies"},
