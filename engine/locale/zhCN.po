msgstr "打开实时通道？"

#: src117/port/front/port_front_settings.cpp:1844
msgid "The setting “{0}” changes when Hyperion next starts."
msgstr "设置“{0}”会在 Hyperion 下次启动时生效。"

#: src117/port/front/port_front_settings.cpp:1847
msgid "Restart now"
msgstr "立即重启"

#: src117/port/front/port_front_settings.cpp:1847
msgid "Later"
msgstr "稍后"

#: src117/port/front/port_front_settings.cpp:1850
#: src117/port/front/port_front_settings.cpp:1854
msgid "Restart Hyperion"
msgstr "重启 Hyperion"

#: src117/port/front/port_front_settings.cpp:1938
