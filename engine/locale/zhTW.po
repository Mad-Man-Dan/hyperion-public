msgstr "{0} 位玩家（原版最多 8 位）"

#: src117/port/front/port_front_skirmish.cpp:862
msgid "a {0} × {1} map (the original allows 256)"
msgstr "{0} × {1} 的地圖（原版最多 256）"

#: src117/port/front/port_front_skirmish.cpp:865
msgid "Team Match (the original has no teams in a game against computers)"
msgstr "隊伍對戰（原版在對電腦的遊戲中沒有隊伍）"

#: src117/port/front/port_front_skirmish.cpp:868
msgid "a computer at {0} (the original has one computer, its own)"
msgstr "等級為 {0} 的電腦（原版只有自己的一種電腦）"

#: src117/port/front/port_front_skirmish.cpp:872
msgid "a handicap (the original has none)"
msgstr "讓分（原版沒有）"

#: src117/port/front/port_front_skirmish.cpp:877
msgid "a unit limit of {0} (the original holds 1,700)"
msgstr "單位上限 {0}（原版可容納 1,700）"

#: src117/port/front/port_front_skirmish.cpp:880
msgid "mutators ({0})"
msgstr "突變因子（{0}）"

#: src117/port/front/port_front_skirmish.cpp:896
msgid "That map has no room for a computer opponent in this game type."
msgstr "在這個遊戲類型下，這張地圖沒有空間安排電腦對手。"

#: src117/port/front/port_front_skirmish.cpp:897
msgid "That game type does not fit this map."
msgstr "這個遊戲類型不適用於這張地圖。"

#: src117/port/front/port_front_skirmish.cpp:898
