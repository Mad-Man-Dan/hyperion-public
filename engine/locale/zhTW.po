msgid "Use as the game's files:"
msgstr "要使用的遊戲檔案："

#: src117/port/data/port_install_window.cpp:183
msgctxt "the install"
msgid "Classic"
msgstr "經典版"

#: src117/port/data/port_install_window.cpp:186
msgid "The other stays linked: switch to it later in Settings, under Hyperion."
msgstr "另一個版本仍會保持連結：之後可以在「設定」的 Hyperion 中切換。"

