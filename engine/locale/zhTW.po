msgid "Start Game"
msgstr "開始遊戲"

#: src117/port/front/port_front_skirmish.cpp:3014
#: src117/port/gameplay/port_trainerview.cpp:851
msgid "Leave"
msgstr "離開"

#: src117/port/front/port_front_skirmish.cpp:3030
msgid "MOD RULES"
msgstr "模組規則"

